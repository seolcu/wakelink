# Copy this file to .env (or set these as real environment variables) and
# fill in the values for your deployment. Never commit the real .env or
# your Firebase service account key.

DB_PATH=./data/wakelink.db
LISTEN_ADDR=:8080

# Path to a Firebase service-account JSON key (Project Settings ->
# Service Accounts -> Generate new private key). Required unless FCM_MOCK
# is set. See /docs/self-hosting.md for why this must be YOUR OWN Firebase
# project if you're running an independent, forked instance of this app.
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Set to "true" for local development without real Firebase credentials --
# pushes are logged instead of sent.
# FCM_MOCK=true

RATE_LIMIT_COOLDOWN_SECONDS=30
RATE_LIMIT_DAILY_CAP=20
INVITE_TTL_SECONDS=600
# Account creations allowed per client IP per hour (0 = unlimited).
REGISTER_LIMIT_PER_HOUR=10

# GET /download redirects here (the newest APK). Defaults to the upstream
# GitHub release; point it at your own fork's releases if you build your
# own APK, or set it to "-" to disable the route.
# APK_DOWNLOAD_URL=https://github.com/seolcu/wakelink/releases/latest/download/wakelink.apk

# SHA-256 fingerprint of the certificate your release APK is signed with
# (apksigner verify --print-certs, or keytool -list -v). Served in
# /.well-known/assetlinks.json so https://<server>/invite/CODE links open
# the app directly. Defaults to the upstream release key; set to "-" to
# disable (invite links then always open the web page).
# ANDROID_CERT_SHA256=C3:CC:93:17:...
